<Window x:Class="GameDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.Desktop"
        Title="Game Doctor 智能体控制台"
        Height="760" Width="1120" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
    <DockPanel Margin="14">

        <!-- ===================== 顶部：主控卡片（新拟物凸起） ===================== -->
        <local:NeuPanel DockPanel.Dock="Top" Padding="16" Margin="0,0,0,14">
            <StackPanel>

                <!-- 行1：游戏文件根目录 + 浏览 / 设置 -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="游戏文件根目录：" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="10,0,0,0">
                        <Button x:Name="SettingsButton" Content="设置" Width="84"
                                Click="OnSettingsClick"/>
                        <Button x:Name="SkillsButton" Content="技能管理" Width="84"
                                Margin="0,6,0,0" Click="OnSkillsClick"/>
                        <Button x:Name="McpButton" Content="MCP 管理" Width="84"
                                Margin="0,6,0,0" Click="OnMcpClick"/>
                    </StackPanel>
                    <Button x:Name="BrowseButton" Content="浏览..." DockPanel.Dock="Right"
                            Width="76" Margin="10,0,0,0" Click="OnBrowseClick"/>
                    <TextBox x:Name="GameDirBox" VerticalAlignment="Center"
                             Text="D:\Games" ToolTip="游戏安装根目录，供智能体定位与访问"/>
                </DockPanel>

                <!-- 行2：当前大模型 + 实时运行状态 + 模式切换 -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="模式：" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <RadioButton x:Name="EditModeRadio" Content="编辑模式" GroupName="RunMode"
                                     IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"
                                     Checked="OnModeChanged"/>
                        <RadioButton x:Name="PlanModeRadio" Content="方案模式" GroupName="RunMode"
                                     VerticalAlignment="Center" Margin="14,0,0,0"
                                     Checked="OnModeChanged"/>
                    </StackPanel>
                    <TextBlock Text="当前大模型：" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModelNameText" Text="—" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="智能体状态：" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLineText" Text="空闲" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 行3：运行状态监控（折叠面板） -->
                <Expander Header="运行状态监控" IsExpanded="True" Margin="0,0,0,6">
                    <StackPanel Margin="0,8,0,0">
                        <DockPanel>
                            <TextBlock Text="当前智能体：" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CurrentAgentText" Text="—" FontWeight="SemiBold"
                                       Margin="0,0,20,0"/>
                            <TextBlock Text="访问路径：" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CurrentPathText" Text="—"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <!-- 事件流：新拟物凹陷通道 -->
                        <ListBox x:Name="EventList" Height="88" Margin="0,8,0,0"
                                 Background="{StaticResource WellBrush}" Padding="8,6"
                                 FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Expander>

                <!-- 行4：设置面板（默认折叠，浅色抬升表面） -->
                <local:NeuPanel x:Name="SettingsPanel" Visibility="Collapsed"
                                Background="{StaticResource BgLightBrush}"
                                Padding="16" Margin="0,10,0,0" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：大模型 API 配置 + 选择 -->
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="大模型 API 配置" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="服务商" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ProviderCombo" Margin="0,4,0,10"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnProviderChanged"/>
                            <TextBlock Text="模型" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ModelCombo" IsEditable="True" Margin="0,4,0,2"
                                      ToolTip="可从下拉选择，也可直接输入自定义模型名，如 glm-4.5-air"/>
                            <TextBlock Text="可直接输入自定义模型名（如 glm-4.5-air）"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       Opacity="0.75" Margin="0,0,0,10"/>
                            <TextBlock Text="API Base URL" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="ApiBaseBox" Margin="0,4,0,10"/>
                            <TextBlock Text="API Key（留空则不修改）"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Grid Margin="0,4,0,6">
                                <!-- 密码模式：默认显示 -->
                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyBoxChanged"/>
                                <!-- 明文模式：勾选「显示密钥」后显示 -->
                                <TextBox x:Name="ApiKeyText" Visibility="Collapsed"
                                         TextChanged="OnApiKeyTextChanged"/>
                            </Grid>
                            <CheckBox x:Name="ShowApiKeyCheck" Content="显示密钥"
                                      Margin="0,0,0,10"
                                      Checked="OnShowApiKeyToggle" Unchecked="OnShowApiKeyToggle"/>

                            <!-- 已保存密钥管理（按厂商各存一份，可删除） -->
                            <TextBlock Text="已保存的密钥" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="SavedKeysList" MaxHeight="120" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button Content="删除" DockPanel.Dock="Right" Width="52"
                                                    Padding="10,4" Margin="8,0,0,0"
                                                    Click="OnDeleteApiKeyClick" Tag="{Binding Provider}"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Display}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 右：智能体启用配置 -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="智能体启用配置" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox x:Name="AgentSettingList" Height="140"
                                     Background="{StaticResource WellBrush}" Padding="6"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="SaveSettingsButton" Content="保存" Width="76"
                                        Margin="0,0,10,0" Click="OnSaveSettingsClick"
                                        Style="{StaticResource NeuAccentButtonStyle}"/>
                                <Button x:Name="CloseSettingsButton" Content="关闭" Width="76"
                                        Click="OnCloseSettingsClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </local:NeuPanel>
            </StackPanel>
        </local:NeuPanel>

        <!-- ===================== 中部：左对话（最大化） | 右侧上下堆叠两框 ===================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- 左：对话区卡片（无标题文字，占满剩余空间） -->
            <local:NeuPanel Grid.Column="0" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="SendButton" Content="发送" DockPanel.Dock="Right"
                                Width="78" Margin="10,0,0,0"
                                IsDefault="True" Click="OnSendClick"
                                Style="{StaticResource NeuAccentButtonStyle}"/>
                        <ToggleButton x:Name="SearchToggle" Content="联网搜索"
                                      DockPanel.Dock="Left" Margin="0,0,10,0"
                                      ToolTip="开启后，大模型可联网搜索解决方案或下载文件"
                                      Checked="OnSearchToggleChanged" Unchecked="OnSearchToggleChanged"/>
                        <ToggleButton x:Name="ThinkToggle" Content="思考强度 ▸"
                                      DockPanel.Dock="Left" Margin="0,0,10,0"
                                      ToolTip="点击展开/收纳思考强度选择"
                                      Checked="OnThinkToggleChanged" Unchecked="OnThinkToggleChanged"/>
                        <TextBox x:Name="ChatInput"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="46" MaxHeight="150"
                                 PreviewKeyDown="OnChatInputKeyDown"
                                 ToolTip="按 Enter 直接发送；Shift+Enter 换行"/>
                    </DockPanel>

                    <!-- 思考强度展开面板（默认收纳，点击「思考强度」按钮展开；新拟物凹陷） -->
                    <local:NeuPanel x:Name="ThinkPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                    Inset="True" Padding="14,10" Margin="0,10,0,0" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock x:Name="ThinkLevelLabel" Text="思考强度：中度"
                                           DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentDeepBrush}"
                                           FontWeight="SemiBold" Margin="0,0,14,0"/>
                                <Slider x:Name="ThinkSlider" Minimum="0" Maximum="2"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="1" VerticalAlignment="Center"
                                        ValueChanged="OnThinkLevelChanged"/>
                            </DockPanel>
                            <!-- 三档刻度文字：轻度 / 中度 / 重度 -->
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="轻度"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="中度"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="重度"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </local:NeuPanel>

                    <!-- 消息流 -->
                    <ListBox x:Name="ChatMessages"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 气泡：新拟物卡片，助手凸起浅灰，用户凸起强调色 -->
                                <local:NeuPanel x:Name="Bubble" Margin="0,5" Padding="14,11"
                                                HorizontalAlignment="Left" CornerRadius="14">
                                    <Grid>
                                        <!-- 普通消息内容 -->
                                        <StackPanel x:Name="TextPanel">
                                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold"
                                                       FontSize="12" Opacity="0.55"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       FontSize="13.5" LineHeight="21"
                                                       Margin="0,5,0,0"/>
                                            <!-- 思考过程展开（仅助手消息且有思考内容时显示） -->
                                            <Expander x:Name="ThinkingExpander" Header="思考过程"
                                                      IsExpanded="False"
                                                      Margin="0,8,0,0"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      Visibility="Collapsed">
                                                <ItemsControl ItemsSource="{Binding Thinking}"
                                                              Margin="0,4,0,0" MaxHeight="260">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                       FontSize="12" LineHeight="18"
                                                                       Opacity="0.7"
                                                                       Margin="0,1,0,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>

                                        <!-- 「正在输入」气泡：三个圆点在气泡内向右滑动（紧凑尺寸） -->
                                        <Border x:Name="DotsHost" Width="84" Height="20"
                                                ClipToBounds="True" Visibility="Collapsed">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <!-- 位移：左缘外 → 中间 → 停留 → 右缘外 -->
                                                            <DoubleAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DotsTranslate"
                                                                Storyboard.TargetProperty="X">
                                                                <LinearDoubleKeyFrame Value="-42" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="21"  KeyTime="0:0:0.6"/>
                                                                <LinearDoubleKeyFrame Value="21"  KeyTime="0:0:1.8"/>
                                                                <LinearDoubleKeyFrame Value="84"  KeyTime="0:0:2.4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <!-- 透明度：边缘淡出，中间可见 -->
                                                            <DoubleAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DotsPanel"
                                                                Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:2.1"/>
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Opacity="0">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="DotsTranslate"/>
                                                </StackPanel.RenderTransform>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource AccentBrush}" Margin="3,0"/>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource AccentBrush}" Margin="3,0"/>
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource AccentBrush}" Margin="3,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </local:NeuPanel>
                                <DataTemplate.Triggers>
                                    <!-- 用户消息：强调色气泡、右对齐、白字 -->
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background"
                                                Value="{StaticResource AccentDeepBrush}"/>
                                        <Setter TargetName="Bubble" Property="TextElement.Foreground"
                                                Value="White"/>
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment"
                                                Value="Right"/>
                                    </DataTrigger>
                                    <!-- 正在输入：隐藏文字，显示滑动圆点 -->
                                    <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                        <Setter TargetName="TextPanel" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="DotsHost" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- 有思考过程：显示展开器 -->
                                    <DataTrigger Binding="{Binding HasThinking}" Value="True">
                                        <Setter TargetName="ThinkingExpander" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </local:NeuPanel>

            <!-- 中：左右分割条（自由调整对话区 / 右侧栏宽度） -->
            <GridSplitter Grid.Column="1" Width="8" Margin="3,0"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ShowsPreview="False" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

            <!-- 右：上下堆叠两卡（智能体列表 + 状态），中间水平分割条可调 -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180" MinHeight="60"/>
                </Grid.RowDefinitions>

                <!-- 右上：智能体列表（中文名） -->
                <local:NeuPanel Grid.Row="0" Padding="14">
                    <DockPanel>
                        <TextBlock Text="智能体" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   DockPanel.Dock="Top" Margin="2,0,0,8"/>
                        <ListBox x:Name="AgentList" SelectionMode="Single"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="OnAgentSelectionChanged"/>
                    </DockPanel>
                </local:NeuPanel>

                <!-- 上下分割条（自由调整两个卡的高度） -->
                <GridSplitter Grid.Row="1" Height="8" Margin="0,4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ShowsPreview="False" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

                <!-- 右下：状态（已加载智能体数 / 当前运行状态） -->
                <local:NeuPanel Grid.Row="2" Padding="14">
                    <DockPanel>
                        <TextBlock Text="状态" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   DockPanel.Dock="Top" Margin="2,0,0,8"/>
                        <TextBlock x:Name="AgentCountText" DockPanel.Dock="Top"
                                   Text="正在连接后端..." FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentDeepBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="StatusText" Text="正在连接后端..."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                </local:NeuPanel>
            </Grid>
        </Grid>

    </DockPanel>

    <!-- 二级页面容器（技能 / MCP 管理，覆盖主界面） -->
    <Frame x:Name="PageHost" Visibility="Collapsed"
           NavigationUIVisibility="Hidden" Background="{StaticResource BgBrush}"/>
    </Grid>
</Window>
