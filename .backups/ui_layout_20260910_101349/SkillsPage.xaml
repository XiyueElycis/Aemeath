<Page x:Class="GameDoctor.Desktop.SkillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="技能管理"
      Background="{StaticResource BgBrush}"
      FontFamily="Microsoft YaHei UI" FontSize="13"
      TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <DockPanel Margin="20">

        <!-- 顶部工具条 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button Content="返回" DockPanel.Dock="Left" Width="76"
                    Click="OnBackClick"/>
            <Button Content="保存" DockPanel.Dock="Right" Width="76"
                    Click="OnSaveClick" Style="{StaticResource NeuAccentButtonStyle}"/>
            <TextBlock Text="已安装的技能（Skill）" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0,0,0"/>
        </DockPanel>

        <!-- 状态提示 -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,10,0,0" Text="正在加载..."/>

        <!-- 技能列表：新拟物凹陷通道 -->
        <ListBox x:Name="SkillList"
                 Background="{StaticResource WellBrush}" Padding="8"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Category}"
                                           Foreground="{StaticResource AccentDeepBrush}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Page>
