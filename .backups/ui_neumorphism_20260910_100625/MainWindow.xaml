<Window x:Class="GameDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Doctor 智能体控制台"
        Height="760" Width="1120" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
    </Window.Resources>

    <Grid>
    <DockPanel Margin="8">

        <!-- ===================== 顶部 ===================== -->
        <Border DockPanel.Dock="Top" BorderBrush="#D9D9D9" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>

                <!-- 行1：游戏文件根目录 + 浏览 / 设置 -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="游戏文件根目录：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="8,0,0,0">
                        <Button x:Name="SettingsButton" Content="设置" Width="80"
                                Padding="8,4" Click="OnSettingsClick"/>
                        <Button x:Name="SkillsButton" Content="技能管理" Width="80"
                                Padding="8,4" Margin="0,3,0,0" Click="OnSkillsClick"/>
                        <Button x:Name="McpButton" Content="MCP 管理" Width="80"
                                Padding="8,4" Margin="0,3,0,0" Click="OnMcpClick"/>
                    </StackPanel>
                    <Button x:Name="BrowseButton" Content="浏览..." DockPanel.Dock="Right"
                            Width="72" Padding="8,4" Margin="8,0,0,0" Click="OnBrowseClick"/>
                    <TextBox x:Name="GameDirBox" VerticalAlignment="Center"
                             Text="D:\Games" ToolTip="游戏安装根目录，供智能体定位与访问"/>
                </DockPanel>

                <!-- 行2：当前大模型 + 实时运行状态 + 模式切换 -->
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="模式：" Foreground="#666666" VerticalAlignment="Center"/>
                        <RadioButton x:Name="EditModeRadio" Content="编辑模式" GroupName="RunMode"
                                     IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0"
                                     Checked="OnModeChanged"/>
                        <RadioButton x:Name="PlanModeRadio" Content="方案模式" GroupName="RunMode"
                                     VerticalAlignment="Center" Margin="10,0,0,0"
                                     Checked="OnModeChanged"/>
                    </StackPanel>
                    <TextBlock Text="当前大模型：" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModelNameText" Text="—" FontWeight="SemiBold"
                               Foreground="#2B6CB0" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock Text="智能体状态：" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusLineText" Text="空闲" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 行3：运行状态监控（折叠面板） -->
                <Expander Header="运行状态监控" IsExpanded="True" Margin="0,0,0,6">
                    <StackPanel Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock Text="当前智能体：" Foreground="#888888"/>
                            <TextBlock x:Name="CurrentAgentText" Text="—" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="访问路径：" Foreground="#888888"/>
                            <TextBlock x:Name="CurrentPathText" Text="—" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ListBox x:Name="EventList" Height="84" Margin="0,6,0,0"
                                 BorderThickness="1" BorderBrush="#E5E5E5"
                                 FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Expander>

                <!-- 行4：设置面板（默认折叠） -->
                <Border x:Name="SettingsPanel" Visibility="Collapsed"
                        BorderBrush="#BBDDFF" BorderThickness="1" CornerRadius="6"
                        Background="#F7FBFF" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：大模型 API 配置 + 选择 -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="大模型 API 配置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="服务商" Foreground="#666666"/>
                            <ComboBox x:Name="ProviderCombo" Margin="0,2,0,8"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnProviderChanged"/>
                            <TextBlock Text="模型" Foreground="#666666"/>
                            <ComboBox x:Name="ModelCombo" IsEditable="True" Margin="0,2,0,2"
                                      ToolTip="可从下拉选择，也可直接输入自定义模型名，如 glm-4.5-air"/>
                            <TextBlock Text="可直接输入自定义模型名（如 glm-4.5-air）"
                                       Foreground="#999999" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="API Base URL" Foreground="#666666"/>
                            <TextBox x:Name="ApiBaseBox" Margin="0,2,0,8"/>
                            <TextBlock Text="API Key（留空则不修改）" Foreground="#666666"/>
                            <Grid Margin="0,2,0,4">
                                <!-- 密码模式：默认显示 -->
                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyBoxChanged"/>
                                <!-- 明文模式：勾选「显示密钥」后显示 -->
                                <TextBox x:Name="ApiKeyText" Visibility="Collapsed"
                                         TextChanged="OnApiKeyTextChanged"/>
                            </Grid>
                            <CheckBox x:Name="ShowApiKeyCheck" Content="显示密钥"
                                      Foreground="#666666" Margin="0,0,0,8"
                                      Checked="OnShowApiKeyToggle" Unchecked="OnShowApiKeyToggle"/>

                            <!-- 已保存密钥管理（按厂商各存一份，可删除） -->
                            <TextBlock Text="已保存的密钥" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="SavedKeysList" MaxHeight="120" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button Content="删除" DockPanel.Dock="Right" Width="48"
                                                    Padding="4,2" Margin="8,0,0,0"
                                                    Click="OnDeleteApiKeyClick" Tag="{Binding Provider}"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Display}" Foreground="#555555"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 右：智能体启用配置 -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="智能体启用配置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ListBox x:Name="AgentSettingList" Height="130"
                                     BorderThickness="1" BorderBrush="#E5E5E5"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="SaveSettingsButton" Content="保存" Width="72"
                                        Padding="8,4" Margin="0,0,8,0" Click="OnSaveSettingsClick"/>
                                <Button x:Name="CloseSettingsButton" Content="关闭" Width="72"
                                        Padding="8,4" Click="OnCloseSettingsClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===================== 中部：左对话（最大化） | 右侧上下堆叠两框 ===================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- 左：对话区（无标题文字，占满剩余空间） -->
            <Border Grid.Column="0" BorderBrush="#D9D9D9" BorderThickness="1"
                    CornerRadius="6" Padding="6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="SendButton" Content="发送" DockPanel.Dock="Right"
                                Width="72" Margin="8,0,0,0" Padding="8,4"
                                IsDefault="True" Click="OnSendClick"/>
                        <ToggleButton x:Name="SearchToggle" Content="联网搜索"
                                      DockPanel.Dock="Left" Margin="0,0,8,0" Padding="10,4"
                                      ToolTip="开启后，大模型可联网搜索解决方案或下载文件"
                                      Checked="OnSearchToggleChanged" Unchecked="OnSearchToggleChanged">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#F2F3F5"/>
                                    <Setter Property="BorderBrush" Value="#D9D9D9"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#555555"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#DCEFF7"/>
                                            <Setter Property="BorderBrush" Value="#2B6CB0"/>
                                            <Setter Property="Foreground" Value="#2B6CB0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ToggleButton x:Name="ThinkToggle" Content="思考强度 ▸"
                                      DockPanel.Dock="Left" Margin="0,0,8,0" Padding="10,4"
                                      ToolTip="点击展开/收纳思考强度选择"
                                      Checked="OnThinkToggleChanged" Unchecked="OnThinkToggleChanged">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#F2F3F5"/>
                                    <Setter Property="BorderBrush" Value="#D9D9D9"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#555555"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#FFF3D6"/>
                                            <Setter Property="BorderBrush" Value="#C98A00"/>
                                            <Setter Property="Foreground" Value="#8A5A00"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <TextBox x:Name="ChatInput" VerticalContentAlignment="Top"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="40" MaxHeight="140"
                                 PreviewKeyDown="OnChatInputKeyDown"
                                 ToolTip="按 Enter 直接发送；Shift+Enter 换行"/>
                    </DockPanel>

                    <!-- 思考强度展开面板（默认收纳，点击「思考强度」按钮展开） -->
                    <Border x:Name="ThinkPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                            BorderBrush="#F0D9A0" BorderThickness="1" CornerRadius="6"
                            Background="#FFFBF0" Padding="10,8" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock x:Name="ThinkLevelLabel" Text="思考强度：中度"
                                           DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="#8A5A00" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <Slider x:Name="ThinkSlider" Minimum="0" Maximum="2"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="1" VerticalAlignment="Center"
                                        ValueChanged="OnThinkLevelChanged"/>
                            </DockPanel>
                            <!-- 三档刻度文字：轻度 / 中度 / 重度 -->
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="轻度" Foreground="#AAAAAA" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="中度" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="重度" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ListBox x:Name="ChatMessages" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="12,10" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F2F3F5"/>
                                            <!-- 默认左对齐、宽度贴合内容；用户消息右对齐 -->
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="#DCEFF7"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- 普通消息内容 -->
                                        <StackPanel x:Name="TextPanel">
                                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold"
                                                       Foreground="#2B6CB0" FontSize="12"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       FontSize="14" LineHeight="22"
                                                       Margin="0,4,0,0"/>
                                            <!-- 思考过程展开（仅助手消息且有思考内容时显示） -->
                                            <Expander x:Name="ThinkingExpander" Header="思考过程"
                                                      IsExpanded="False"
                                                      Margin="0,8,0,0"
                                                      Foreground="#6B6B6B"
                                                      Visibility="Collapsed">
                                                <ItemsControl ItemsSource="{Binding Thinking}"
                                                              Margin="0,4,0,0" MaxHeight="260">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                       FontSize="12" LineHeight="18"
                                                                       Foreground="#777777"
                                                                       Margin="0,1,0,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>

                                        <!-- 「正在输入」气泡：三个蓝点在气泡内向右滑动（紧凑尺寸） -->
                                        <Border x:Name="DotsHost" Width="84" Height="20"
                                                ClipToBounds="True" Visibility="Collapsed">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <!-- 位移：左缘外 → 中间 → 停留 → 右缘外 -->
                                                            <DoubleAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DotsTranslate"
                                                                Storyboard.TargetProperty="X">
                                                                <LinearDoubleKeyFrame Value="-42" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="21"  KeyTime="0:0:0.6"/>
                                                                <LinearDoubleKeyFrame Value="21"  KeyTime="0:0:1.8"/>
                                                                <LinearDoubleKeyFrame Value="84"  KeyTime="0:0:2.4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <!-- 透明度：边缘淡出，中间可见 -->
                                                            <DoubleAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DotsPanel"
                                                                Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:2.1"/>
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                                       VerticalAlignment="Center" Opacity="0">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="DotsTranslate"/>
                                                </StackPanel.RenderTransform>
                                                <Ellipse Width="8" Height="8" Fill="#2B6CB0" Margin="3,0"/>
                                                <Ellipse Width="8" Height="8" Fill="#2B6CB0" Margin="3,0"/>
                                                <Ellipse Width="8" Height="8" Fill="#2B6CB0" Margin="3,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- 正在输入：隐藏文字，显示滑动蓝点 -->
                                    <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                        <Setter TargetName="TextPanel" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="DotsHost" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- 有思考过程：显示展开器 -->
                                    <DataTrigger Binding="{Binding HasThinking}" Value="True">
                                        <Setter TargetName="ThinkingExpander" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 中：左右分割条（自由调整对话区 / 右侧栏宽度） -->
            <GridSplitter Grid.Column="1" Width="6" Margin="2,0"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ShowsPreview="False" Background="#D9D9D9"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

            <!-- 右：上下堆叠两框（智能体列表 + 状态），中间水平分割条可调 -->
            <Grid Grid.Column="2" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180" MinHeight="60"/>
                </Grid.RowDefinitions>

                <!-- 右上：智能体列表（中文名） -->
                <GroupBox Header="智能体" Grid.Row="0" Padding="6">
                    <ListBox x:Name="AgentList" SelectionMode="Single"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="OnAgentSelectionChanged"/>
                </GroupBox>

                <!-- 上下分割条（自由调整两个框的高度） -->
                <GridSplitter Grid.Row="1" Height="6" Margin="0,2"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ShowsPreview="False" Background="#D9D9D9"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

                <!-- 右下：状态（已加载智能体数 / 当前运行状态） -->
                <GroupBox Header="状态" Grid.Row="2" Padding="6">
                    <DockPanel>
                        <TextBlock x:Name="AgentCountText" DockPanel.Dock="Top"
                                   Text="正在连接后端..." FontWeight="SemiBold"
                                   Foreground="#2B6CB0" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusText" Text="正在连接后端..."
                                   TextWrapping="Wrap" Foreground="#555555"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>

    </DockPanel>

    <!-- 二级页面容器（技能 / MCP 管理，覆盖主界面） -->
    <Frame x:Name="PageHost" Visibility="Collapsed"
           NavigationUIVisibility="Hidden" Background="#F7F9FC"/>
</Grid>
</Window>