<Page x:Class="GameDoctor.Desktop.SkillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="技能管理"
      Background="#F7F9FC">

    <DockPanel Margin="16">

        <!-- 顶部工具条 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="返回" DockPanel.Dock="Left" Width="72" Padding="8,4"
                    Click="OnBackClick"/>
            <Button Content="保存" DockPanel.Dock="Right" Width="72" Padding="8,4"
                    Click="OnSaveClick"/>
            <TextBlock Text="已安装的技能（Skill）" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <!-- 状态提示 -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#888888"
                   Margin="0,8,0,0" Text="正在加载..."/>

        <!-- 技能列表 -->
        <ListBox x:Name="SkillList" BorderThickness="1" BorderBrush="#D9D9D9"
                 HorizontalContentAlignment="Stretch" Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,8" Margin="0,1" CornerRadius="4">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,12,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Category}" Foreground="#2B6CB0" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="#777777"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Page>