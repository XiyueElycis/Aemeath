<Application x:Class="AemeathAgent.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AemeathAgent.Desktop"
             ShutdownMode="OnExplicitShutdown">
    <!-- 启动流程在 App.xaml.cs 显式编排：
         StartupWindow（启动动画，可关闭）→ MainWindow（主控制台）。
         OnExplicitShutdown 是为了让唯一的启动动画窗口关闭时不触发应用退出；
         主窗口显示后切回 OnLastWindowClose。 -->
    <Application.Resources>

        <!-- ================================================== -->
        <!--  爱弥斯（AEMEATH）× 明亮未来生物科技终端 设计令牌     -->
        <!--  暖白=环境 / 青蓝=科技 / 粉=AI品牌 / 藏青=结构 / 金=装饰 -->
        <!-- ================================================== -->
        <!-- 窗口底色：暖白（环境色） -->
        <SolidColorBrush x:Key="BgBrush" Color="#F7F5EF"/>
        <!-- 面板：纯白 -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <!-- 侧边栏：米白 -->
        <SolidColorBrush x:Key="SidebarBrush" Color="#F3F1EA"/>
        <!-- 凹槽：浅米灰 -->
        <SolidColorBrush x:Key="WellBrush" Color="#ECEBE5"/>
        <SolidColorBrush x:Key="WellHoverBrush" Color="#E3F6F9"/>
        <!-- 描边：浅灰细线 / 强描边中灰 -->
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DCE0"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#A7AFB7"/>
        <!-- 科技色：青蓝（HUD/导航/数据流/主操作） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#59CFE0"/>
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#45BFD2"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3F6F9"/>
        <!-- 状态数据色：深青 -->
        <SolidColorBrush x:Key="DataAccentBrush" Color="#45BFD2"/>
        <SolidColorBrush x:Key="DataAccentSoftBrush" Color="#E3F6F9"/>
        <!-- 状态灯三色：正常青蓝 / 忙碌香槟金 / 异常柔红 -->
        <SolidColorBrush x:Key="StatusOkBrush" Color="#45BFD2"/>
        <SolidColorBrush x:Key="StatusBusyBrush" Color="#CDBB8E"/>
        <SolidColorBrush x:Key="StatusErrorBrush" Color="#E07A7A"/>
        <!-- AI 品牌色：爱弥斯粉（角色/Active Agent/AI 状态） -->
        <SolidColorBrush x:Key="PinkBrush" Color="#F28FB6"/>
        <SolidColorBrush x:Key="PinkDeepBrush" Color="#E97FA9"/>
        <SolidColorBrush x:Key="PinkSoftBrush" Color="#FCE9F1"/>
        <!-- 高级装饰：香槟金 -->
        <SolidColorBrush x:Key="GoldBrush" Color="#CDBB8E"/>
        <SolidColorBrush x:Key="GoldDeepBrush" Color="#BCA878"/>
        <!-- 文字：藏青（结构色） / 次级灰 -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#263B62"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7F8A94"/>
        <!-- 气泡：爱弥斯浅粉底 + 粉细边；用户浅青底 + 青蓝细边 -->
        <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#FDF4F9"/>
        <SolidColorBrush x:Key="BubbleUserBrush" Color="#F0FAFC"/>
        <SolidColorBrush x:Key="BubbleAssistantLineBrush" Color="#66F28FB6"/>
        <SolidColorBrush x:Key="BubbleUserLineBrush" Color="#6659CFE0"/>
        <!-- 浅青面板：思考强度选择面板凹槽填充 -->
        <SolidColorBrush x:Key="BluePanelBrush" Color="#E3F6F9"/>
        <SolidColorBrush x:Key="BlueAccentDeepBrush" Color="#45BFD2"/>

        <!-- 等宽数据字体：所有 HUD 数据统一使用 -->
        <FontFamily x:Key="DataFont">Cascadia Code, Consolas, JetBrains Mono</FontFamily>

        <!-- 键盘焦点可视样式 -->
        <Style x:Key="NeuFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="4" BorderBrush="{StaticResource AccentDeepBrush}"
                                BorderThickness="1.6" Opacity="0.7" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  SelectableText：只读 TextBox，外观等同 TextBlock     -->
        <!--  用于聊天气泡、事件流等需要鼠标拖选 + Ctrl+C 的文本   -->
        <!-- ================================================== -->
        <Style x:Key="SelectableText" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectionBrush" Value="#4059CFE0"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  NeuPanel：白色卡片容器（扁平 + 细描边 + 轻投影）     -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type local:NeuPanel}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <!-- 默认极细边框；气泡等场景可在实例上覆盖为粉/蓝细描边 -->
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:NeuPanel}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <!-- 浅色主题：轻投影（暖白卡片 + 细边 + 柔和阴影） -->
                                <DropShadowEffect Color="#263B62" Direction="270"
                                                  BlurRadius="12" ShadowDepth="1" Opacity="0.10"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Inset" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Bg" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="Bg" Property="Background">
                                    <Setter.Value>
                                        <Binding Path="PanelBackground"
                                                 RelativeSource="{RelativeSource TemplatedParent}"
                                                 Converter="{x:Static local:PanelBackgroundConverter.Instance}"
                                                 ConverterParameter="{StaticResource WellBrush}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  Button：扁平白按钮，悬停浅蓝、按下微暗               -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NeuFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <!-- 悬停/按下遮罩：青蓝微光，适配浅色底 -->
                            <Border x:Name="HoverOverlay" Background="#1459CFE0" CornerRadius="4"
                                    Visibility="Collapsed" IsHitTestVisible="false"/>
                            <Border x:Name="PressOverlay" Background="#14263B62" CornerRadius="4"
                                    Visibility="Collapsed" IsHitTestVisible="false"/>
                            <!-- 悬停扫光：70px 青蓝渐变条从左掠过（仅 Transform 动画） -->
                            <Rectangle x:Name="HoverShimmer" Width="70" IsHitTestVisible="false"
                                       RadiusX="4" RadiusY="4" Opacity="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#2259CFE0" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="HoverShimmerX" X="-70"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverShimmerX"
                                                             Storyboard.TargetProperty="X"
                                                             From="-70" To="360" Duration="0:0:0.5"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverShimmer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作按钮（CTA）：青蓝渐变实心 + 悬停青蓝辉光 -->
        <Style x:Key="NeuAccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#45BFD2" BlurRadius="14"
                                              ShadowDepth="0" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 粉色实心按钮：爱弥斯角色相关入口（与 AI 品牌色一致） -->
        <Style x:Key="PinkAccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PinkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkDeepBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F28FB6" BlurRadius="14"
                                              ShadowDepth="0" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 侧边栏终端导航：悬停/按下时左侧 2px 青蓝指示条 + 浅青底 -->
        <Style x:Key="SideNavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NeuFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <Grid>
                                <!-- 左指示条：常态隐，悬停/按下显 -->
                                <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentDeepBrush}" Opacity="0"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  细线进度条：4px + 光效扫过（1.2s 循环）             -->
        <!-- ================================================== -->
        <Style x:Key="ThinProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" CornerRadius="2"
                                    Background="{StaticResource WellBrush}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"/>
                            <!-- 光效：白色渐变斜条从左扫到右 -->
                            <Rectangle x:Name="Shimmer" Width="70" IsHitTestVisible="False"
                                       Fill="#33FFFFFF" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Left">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ShimmerX" X="-70"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="ShimmerX"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-70" To="320" Duration="0:0:1.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  ToggleButton：选中态浅蓝底 + 蓝字                    -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NeuFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                            </Border>
                            <Border x:Name="PressOverlay" Background="#14263B62" CornerRadius="4"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressOverlay" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 选中：浅青底 + 青蓝边（青蓝=科技/操作） -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  TextBox / PasswordBox：白底细边，聚焦蓝边           -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="#4059CFE0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <!-- 聚焦青蓝光晕 -->
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#45BFD2" BlurRadius="8"
                                                          ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="#4059CFE0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <!-- 聚焦青蓝光晕 -->
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#45BFD2" BlurRadius="8"
                                                          ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  CheckBox：白底圆角方块，勾选蓝底白勾                -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NeuFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="19" Height="19" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border x:Name="Box" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1.4" CornerRadius="3"/>
                                <Path x:Name="Check" Data="M3.5,8 L7.5,11.5 12.5,4.5"
                                      Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentDeepBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  RadioButton：白底圆片，选中蓝环蓝点                  -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NeuFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="19" Height="19" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Border x:Name="Box" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1.4" CornerRadius="10"/>
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource PinkBrush}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  ComboBox：白底选择器 + 白色卡片下拉                  -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Toggle" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1" CornerRadius="4"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WellHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="4,0" Padding="8,6"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     Visibility="Hidden"
                                     Foreground="{TemplateBinding Foreground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Focusable="True"/>
                            <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="#7F8A94" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="2,0,14,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                  PopupAnimation="Fade">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Margin="10,2,10,12" Padding="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#263B62" Direction="270"
                                                          BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Margin="1,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  ListBox / ListBoxItem：无边框列表 + 圆角悬停/选中    -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WellBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  Slider：浅灰轨道 + 蓝色已填充段 + 白圆钮             -->
        <!-- ================================================== -->
        <Style x:Key="NeuSliderRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" Height="24"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeuSliderFillStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{StaticResource AccentDeepBrush}" Height="6" CornerRadius="3"
                                VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeuSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="18" Height="18">
                            <Border Background="White" CornerRadius="9"
                                    BorderBrush="{StaticResource AccentDeepBrush}" BorderThickness="1.6">
                                <Border.Effect>
                                    <DropShadowEffect Color="#45BFD2"
                                                      BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource WellBrush}"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource NeuSliderFillStyle}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource NeuSliderRepeatButtonStyle}"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NeuSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  Expander：折叠面板                                 -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow" Data="M4.5,2 L9,6.5 4.5,11"
                                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" CenterX="6" CenterY="6"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" CenterX="6" CenterY="6"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Content>
                                    <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================================================== -->
        <!--  GridSplitter：浅色圆角分隔条                        -->
        <!-- ================================================== -->
        <Style TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Grid Background="Transparent">
                            <Border Background="{StaticResource BorderStrongBrush}" CornerRadius="3" Margin="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
