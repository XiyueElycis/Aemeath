<Window x:Class="AemeathAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AemeathAgent.Desktop"
        Title="爱弥斯 · 智能体控制台"
        Icon="Assets/brand.png"
        Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- ============ 主界面专用精密样式 ============ -->
        <!-- 信息条 -->
        <Style x:Key="OpTop" TargetType="Border">
            <Setter Property="Margin" Value="2,0,2,0"/>
        </Style>
        <Style x:Key="OpTopK" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextElement.FontSize" Value="10"/>
        </Style>
        <!-- 面板标题 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="PanelSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="2,12,0,5"/>
        </Style>
        <!-- 档案行 -->
        <Style x:Key="KvKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="KvVal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <!-- 实验标签 -->
        <Style x:Key="LabTag" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="7,2.5"/>
        </Style>
        <Style x:Key="LabTagText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- 四角数据 -->
        <Style x:Key="CornerData" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextElement.FontSize" Value="9"/>
        </Style>
        <!-- 节点标签 -->
        <Style x:Key="NodeTagText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="NodeTagEm" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- 配置段标签 -->
        <Style x:Key="CfgLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- 小状态灯闪烁（错相由 BeginTime 控制） -->
        <Style x:Key="BlinkLed" TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="(local:Fx.MotionEnabled)" RelativeSource="{RelativeSource Self}"/>
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.4" AutoReverse="True"
                                                 Duration="0:0:2.6" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 极淡科技网格背景（28px，青蓝科技色） ============ -->
        <Border Grid.ColumnSpan="2" x:Name="GridLayer" IsHitTestVisible="False">
            <Border.Background>
                <DrawingBrush x:Name="GridBrush" TileMode="Tile"
                              Viewport="0,0,28,28" ViewportUnits="Absolute"
                              Viewbox="0,0,28,28" ViewboxUnits="Absolute">
                    <DrawingBrush.Transform>
                        <TranslateTransform x:Name="GridPan"/>
                    </DrawingBrush.Transform>
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#1259CFE0" Thickness="1"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="28,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,28"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- ============ 进入角色交互时的压暗遮罩（藏青半透，代码控制） ============ -->
        <Border Grid.ColumnSpan="2" x:Name="HeartDimOverlay"
                Background="#99263B62" Opacity="0" IsHitTestVisible="False"/>

        <!-- ===================== 左侧边栏 ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- 侧边栏底部：HUD 状态块 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                        <Ellipse x:Name="BackendLight" Width="7" Height="7"
                                 Fill="{StaticResource StatusBusyBrush}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="BackendStateText" Text="连接中"
                                   FontFamily="{StaticResource DataFont}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusBusyBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="AgentCountText" Text="正在连接后端..."
                               FontFamily="{StaticResource DataFont}" FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentDeepBrush}"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" Text="正在连接后端..." TextWrapping="Wrap"
                               FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                    <Button x:Name="ReviewPendingButton" Content="待审核沙箱（0）"
                            Visibility="Collapsed"
                            Style="{StaticResource NeuAccentButtonStyle}"
                            Click="OnReviewPendingClick"/>

                    <TextBlock Text="POWERED BY AEMEATH"
                               FontFamily="{StaticResource DataFont}"
                               FontSize="8.5" Opacity="0.7"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 品牌标识 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,6">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource PinkSoftBrush}" Padding="4">
                        <Image Source="Assets/brand.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="爱弥斯" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="AEMEATH AGENT · 星海轻歌"
                                   FontFamily="{StaticResource DataFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentDeepBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <StackPanel DockPanel.Dock="Top" Margin="12,4,12,0">
                    <TextBlock Text="系统" Style="{StaticResource GroupLabel}" Margin="2,4,0,5"/>
                    <Button x:Name="ConsoleNavButton" Content="智能控制台"
                            Style="{StaticResource SideNavButtonStyle}"
                            Click="OnConsoleNavClick"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button x:Name="DirectiveNavButton" Content="指令中枢" Margin="0,2,0,0"
                            Style="{StaticResource SideNavButtonStyle}"
                            Click="OnDirectiveNavClick" ToolTip="下达指令并查看对话"/>

                    <!-- 心动模式：角色专属入口，刻意做成醒目卡片，与普通导航区分 -->
                    <Button x:Name="HeartModeButton" Margin="0,8,0,6" Height="68"
                            Cursor="Hand" Click="OnHeartModeClick"
                            ToolTip="进入爱弥斯角色专属页面：她会主动找你搭话">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Bd" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="#F27BB4" Padding="12,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3A1A43" Offset="0"/>
                                            <GradientStop Color="#71305C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#F27BB4" BlurRadius="20"
                                                          ShadowDepth="0" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- 右侧留出 26px 给爱心图标，避免长标题压到它 -->
                                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,26,0"/>
                                        <TextBlock Text="♥" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="22"
                                                   Foreground="#FFD9EC" Opacity="0.92"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB6D9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock Text="心动模式" FontSize="16" FontWeight="Bold"
                                       Foreground="#FFE9F4"/>
                            <TextBlock Text="HEARTLINK · 和爱弥斯的独处时间"
                                       FontFamily="{StaticResource DataFont}"
                                       FontSize="9.5" Foreground="#E7A9CB" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 智能体列表：默认折叠，点标题展开 -->
                <StackPanel Margin="12,2,12,6">
                    <Button x:Name="AgentToggleButton" Click="OnAgentToggleClick"
                            Style="{StaticResource SideNavButtonStyle}" FontWeight="SemiBold">
                        <DockPanel>
                            <TextBlock x:Name="AgentChevron" DockPanel.Dock="Right" Text="▸"
                                       Foreground="{StaticResource AccentDeepBrush}"
                                       FontFamily="{StaticResource DataFont}"/>
                            <TextBlock x:Name="AgentToggleText" Text="智能体"/>
                        </DockPanel>
                    </Button>
                    <Border x:Name="AgentPanel" Visibility="Collapsed" Margin="0,2,0,0">
                        <ListBox x:Name="AgentList" SelectionMode="Single"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="OnAgentSelectionChanged"/>
                    </Border>
                </StackPanel>

                <!-- 模块 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,8">
                    <TextBlock Text="模块" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="SkillsButton" Content="技能管理"
                            Style="{StaticResource SideNavButtonStyle}"
                            Click="OnSkillsClick"/>
                    <Button x:Name="McpButton" Content="MCP 管理" Margin="0,2,0,0"
                            Style="{StaticResource SideNavButtonStyle}"
                            Click="OnMcpClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== 右侧主区：双视图 ===================== -->
        <Grid Grid.Column="1" Margin="14">

            <!-- ============ 视图一：智能控制台 ============ -->
            <Grid x:Name="ConsoleView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 信息条：会话 + HUD -->
                <Border Grid.Row="0" Style="{StaticResource OpTop}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    TextElement.FontFamily="{StaticResource DataFont}">
                            <TextBlock Text="温度" Style="{StaticResource OpTopK}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudTempVal" Text="36.7"
                                       Foreground="{StaticResource AccentDeepBrush}"
                                       FontFamily="{StaticResource DataFont}" FontSize="10" MinWidth="24" TextAlignment="Right"/>
                            <TextBlock Text="°C" Style="{StaticResource OpTopK}" Margin="2,0,14,0"/>
                            <TextBlock Text="O₂" Style="{StaticResource OpTopK}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudOxyVal" Text="98.4"
                                       Foreground="{StaticResource AccentDeepBrush}"
                                       FontFamily="{StaticResource DataFont}" FontSize="10" MinWidth="24" TextAlignment="Right"/>
                            <TextBlock Text="%" Style="{StaticResource OpTopK}" Margin="2,0,14,0"/>
                            <TextBlock Text="网络" Style="{StaticResource OpTopK}" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HudNetVal" Text="1.8"
                                       Foreground="{StaticResource AccentDeepBrush}"
                                       FontFamily="{StaticResource DataFont}" FontSize="10" MinWidth="20" TextAlignment="Right"/>
                            <TextBlock Text="G/s" Style="{StaticResource OpTopK}" Margin="2,0,14,0"/>
                            <TextBlock Text="安全" Style="{StaticResource OpTopK}" Margin="0,0,4,0"/>
                            <TextBlock Text="A-3" FontFamily="{StaticResource DataFont}" FontSize="10"
                                       Foreground="{StaticResource GoldDeepBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="16" Height="2" Background="{StaticResource AccentDeepBrush}"
                                    Margin="0,0,9,0"/>
                            <TextBlock Text="会话" Style="{StaticResource OpTopK}"/>
                            <TextBlock Text="AEM-20261007-01" FontFamily="{StaticResource DataFont}"
                                       FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                            <TextBlock Text="· 实验节点 上海-07 · 链路稳定" Style="{StaticResource OpTopK}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 三列 -->
                <Grid x:Name="OsGrid" Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="226"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="232"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 身份档案 ===== -->
                    <local:NeuPanel Grid.Column="0" Padding="0" CornerRadius="5">
                        <StackPanel Margin="15">
                            <!-- 大头像：三重环 -->
                            <Grid Width="80" Height="80" HorizontalAlignment="Center">
                                <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4"/>
                                <Ellipse Margin="5" Stroke="{StaticResource GoldBrush}"
                                         StrokeDashArray="3 3"/>
                                <Ellipse Margin="11" Stroke="{StaticResource AccentDeepBrush}"
                                         StrokeThickness="1.4"/>
                                <Border Margin="13" CornerRadius="30">
                                    <Image Source="Assets/brand.png" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="爱弥斯" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="AEMEATH · 生物型智能终端"
                                       Style="{StaticResource PanelSub}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

                            <!-- 档案 -->
                            <StackPanel Margin="2,12,2,0">
                                <Grid Margin="0,4">
                                    <TextBlock Text="单元编号" Style="{StaticResource KvKey}"/>
                                    <TextBlock Text="AEM-001" Style="{StaticResource KvVal}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="上下文" Style="{StaticResource KvKey}"/>
                                    <TextBlock Text="128K" Style="{StaticResource KvVal}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="所属部门" Style="{StaticResource KvKey}"/>
                                    <TextBlock Text="拉贝尔学部" Style="{StaticResource KvVal}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- 生命状态 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="2,10,2,0"/>
                            <TextBlock Text="生命状态" FontFamily="{StaticResource DataFont}" FontSize="9"
                                       Foreground="{StaticResource AccentDeepBrush}" Margin="2,8,0,2"/>
                            <Grid Margin="2,3">
                                <TextBlock Text="生命节律" Style="{StaticResource KvKey}"/>
                                <TextBlock Text="72 次/分" Style="{StaticResource KvVal}"
                                           Foreground="{StaticResource PinkDeepBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="2,3">
                                <TextBlock Text="细胞同步" Style="{StaticResource KvKey}"/>
                                <TextBlock Text="98.4%" Style="{StaticResource KvVal}"
                                           Foreground="{StaticResource AccentDeepBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="神经链路" FontFamily="{StaticResource DataFont}" FontSize="9"
                                       Foreground="{StaticResource AccentDeepBrush}" Margin="2,8,0,2"/>
                            <Grid Margin="2,3">
                                <TextBlock Text="链路带宽" Style="{StaticResource KvKey}"/>
                                <TextBlock Text="1.80 G/s" Style="{StaticResource KvVal}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="2,3">
                                <TextBlock Text="神经延迟" Style="{StaticResource KvKey}"/>
                                <TextBlock Text="12 ms" Style="{StaticResource KvVal}"
                                           Foreground="{StaticResource AccentDeepBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- 标签 -->
                            <WrapPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource LabTag}">
                                    <TextBlock Text="生物同步" Style="{StaticResource LabTagText}" Foreground="{StaticResource AccentDeepBrush}"/>
                                </Border>
                                <Border Style="{StaticResource LabTag}" Margin="6,0,0,0">
                                    <TextBlock Text="实验链路" Style="{StaticResource LabTagText}"/>
                                </Border>
                                <Border Style="{StaticResource LabTag}" Margin="6,0,0,0">
                                    <TextBlock Text="神经" Style="{StaticResource LabTagText}"/>
                                </Border>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentDeepBrush}"/>
                                <TextBlock Text="单元在线" FontFamily="{StaticResource DataFont}" FontSize="10"
                                           Margin="7,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </local:NeuPanel>

                    <!-- ===== Neural Core 生命装置 ===== -->
                    <local:NeuPanel Grid.Column="1" Margin="12,0" Padding="0" CornerRadius="5">
                        <Grid ClipToBounds="True">
                            <!-- 极淡同心圆背景 -->
                            <Ellipse Width="380" Height="380" Stroke="#1059CFE0"
                                     StrokeDashArray="2 6"/>
                            <Ellipse Width="280" Height="280" Stroke="#0E59CFE0"/>
                            <Ellipse Width="150" Height="150" Stroke="#10CDBB8E"/>

                            <!-- 四角数据 -->
                            <TextBlock Style="{StaticResource CornerData}" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" Margin="14,12,0,0">
                                <Run Text="核心编号"/><LineBreak/>
                                <Run Text="信号 稳定" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CornerData}" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,12,14,0" TextAlignment="Right">
                                <Run Text="同步率 98.7%"/><LineBreak/>
                                <Run Text="上行 1.8G/s" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CornerData}" HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom" Margin="14,0,0,12">
                                <Run Text="生物链路 " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="活跃" Foreground="{StaticResource PinkDeepBrush}" FontWeight="Bold"/><LineBreak/>
                                <Run Text="脉冲 72 次/分"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource CornerData}" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Margin="0,0,14,12" TextAlignment="Right">
                                <Run Text="权限 " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="A-3" Foreground="{StaticResource GoldDeepBrush}" FontWeight="Bold"/><LineBreak/>
                                <Run Text="运行 00:14:22"/>
                            </TextBlock>

                            <!-- 环体 -->
                            <Grid Width="300" Height="300">
                                <Ellipse Stroke="#1859CFE0" StrokeDashArray="2 6"/>
                                <Ellipse Stroke="{StaticResource AccentDeepBrush}" StrokeThickness="1.5"
                                         StrokeDashArray="560 180" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="CoreArcRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Stroke="{StaticResource GoldBrush}"/>
                                <Ellipse Stroke="#2259CFE0" StrokeDashArray="4 4" Margin="28"/>

                                <!-- Neural Core 能量球 -->
                                <Ellipse x:Name="NeuralOrb" Width="84" Height="84">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#FBD3E4" Offset="0.32"/>
                                            <GradientStop Color="#F28FB6" Offset="0.72"/>
                                            <GradientStop Color="#E97FA9" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#F28FB6" BlurRadius="26"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="OrbScale" CenterX="42" CenterY="42"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard x:Name="OrbBreatheSb">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="OrbScale"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     From="1" To="1.06" AutoReverse="True"
                                                                     Duration="0:0:3.8" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetName="OrbScale"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     From="1" To="1.06" AutoReverse="True"
                                                                     Duration="0:0:3.8" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                                <!-- 弱化意识锚点小头像 -->
                                <Border Width="40" Height="40" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center" Margin="0,0,0,-18"
                                        CornerRadius="20" Background="{StaticResource AccentDeepBrush}" Padding="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#263B62" BlurRadius="10"
                                                          ShadowDepth="1" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Border CornerRadius="18">
                                        <Image Source="Assets/brand.png" Stretch="UniformToFill"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- 节点标签 -->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource PinkBrush}"
                                             VerticalAlignment="Center" Style="{StaticResource BlinkLed}"/>
                                    <TextBlock Text="神经核心 " Style="{StaticResource NodeTagText}" Margin="6,0,0,0"/>
                                    <TextBlock Text="92%" Style="{StaticResource NodeTagEm}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentDeepBrush}"
                                             VerticalAlignment="Center" Style="{StaticResource BlinkLed}"/>
                                    <TextBlock Text="生物链路" Style="{StaticResource NodeTagText}" Margin="6,0,0,0"/>
                                    <TextBlock Text="稳定" Style="{StaticResource NodeTagEm}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="已锁定" Style="{StaticResource NodeTagEm}" Margin="0,0,2,0"/>
                                    <TextBlock Text="同步状态" Style="{StaticResource NodeTagText}" Margin="0,0,6,0"/>
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource GoldDeepBrush}"
                                             VerticalAlignment="Center" Style="{StaticResource BlinkLed}"/>
                                </StackPanel>
                            </Border>

                            <!-- 纵向扫描线 -->
                            <Border x:Name="CoreScan" Height="1" Margin="34,0"
                                    Background="{StaticResource AccentDeepBrush}" Opacity="0.6"
                                    HorizontalAlignment="Stretch" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="CoreScanY"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard x:Name="CoreScanSb">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CoreScanY"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="4" To="240" AutoReverse="True"
                                                                 Duration="0:0:4.6" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </local:NeuPanel>

                    <!-- ===== 右列：研究机构数据 ===== -->
                    <StackPanel x:Name="RightCol" Grid.Column="2">

                        <!-- 研究节点 -->
                        <local:NeuPanel Padding="0" CornerRadius="5">
                            <StackPanel>
                                <DockPanel Margin="14,10,14,6">
                                    <Border Width="14" Height="2" Background="{StaticResource AccentDeepBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="研究节点" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                                    <TextBlock Text="04 运行" Style="{StaticResource PanelSub}"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="10,0"/>
                                <StackPanel Margin="14,4,14,8">
                                    <Grid Margin="0,5">
                                        <TextBlock Text="N-01" Style="{StaticResource KvKey}" Width="34"/>
                                        <TextBlock Text="神经核心" Style="{StaticResource KvKey}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="同步 98%" Style="{StaticResource PanelSub}" Margin="6,0,0,0"
                                                       Foreground="{StaticResource AccentDeepBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <TextBlock Text="N-02" Style="{StaticResource KvKey}" Width="34"/>
                                        <TextBlock Text="记忆索引" Style="{StaticResource KvKey}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource PinkBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="活跃" Style="{StaticResource PanelSub}" Margin="6,0,0,0"
                                                       Foreground="{StaticResource PinkDeepBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <TextBlock Text="N-03" Style="{StaticResource KvKey}" Width="34"/>
                                        <TextBlock Text="工具沙箱" Style="{StaticResource KvKey}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoldDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="待命" Style="{StaticResource PanelSub}" Margin="6,0,0,0"
                                                       Foreground="{StaticResource GoldDeepBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <TextBlock Text="N-04" Style="{StaticResource KvKey}" Width="34"/>
                                        <TextBlock Text="数据链路" Style="{StaticResource KvKey}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="在线" Style="{StaticResource PanelSub}" Margin="6,0,0,0"
                                                       Foreground="{StaticResource AccentDeepBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </local:NeuPanel>

                        <!-- 数据日志 -->
                        <local:NeuPanel Padding="0" CornerRadius="5" Margin="0,12,0,0">
                            <StackPanel Margin="14,10,14,12">
                                <DockPanel Margin="0,0,0,6">
                                    <Border Width="14" Height="2" Background="{StaticResource AccentDeepBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="数据日志" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                                    <TextBlock Text="实时" Style="{StaticResource PanelSub}"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="-4,0"/>
                                <Grid Margin="0,8,0,2">
                                    <TextBlock Text="上行" Style="{StaticResource KvKey}"/>
                                    <TextBlock Text="1.82 G/s" Style="{StaticResource KvVal}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="下行" Style="{StaticResource KvKey}"/>
                                    <TextBlock Text="4.36 G/s" Style="{StaticResource KvVal}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="脉冲" Style="{StaticResource KvKey}"/>
                                    <TextBlock Text="72 次/分" Style="{StaticResource KvVal}"
                                               Foreground="{StaticResource PinkDeepBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Canvas Height="30" Margin="0,8,0,0" ClipToBounds="True">
                                    <Polyline Points="0,20 14,20 20,8 26,28 34,14 48,14 56,6 64,26 78,16 92,16 100,9 108,24 124,13 138,13 146,4 154,26 170,18 196,18"
                                              Stroke="{StaticResource AccentDeepBrush}" StrokeThickness="1.2"/>
                                    <Polyline Points="0,24 20,24 30,18 44,22 60,15 76,22 96,18 112,24 130,17 148,22 168,13 196,20"
                                              Stroke="{StaticResource PinkBrush}" StrokeThickness="1" Opacity="0.75"/>
                                </Canvas>
                            </StackPanel>
                        </local:NeuPanel>

                        <!-- 安全状态 -->
                        <local:NeuPanel Padding="0" CornerRadius="5" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Margin="14,10,14,6">
                                    <Border Width="14" Height="2" Background="{StaticResource AccentDeepBrush}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="安全状态" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                                    <TextBlock Text="A-3" Style="{StaticResource PanelSub}"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right"
                                               Foreground="{StaticResource GoldDeepBrush}"/>
                                </DockPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="10,0"/>
                                <StackPanel Margin="14,4,14,10">
                                    <Grid Margin="0,4">
                                        <TextBlock Text="协议" Style="{StaticResource KvKey}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource GoldDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="A-3" Style="{StaticResource KvVal}" Margin="6,0,0,0"
                                                       Foreground="{StaticResource GoldDeepBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="加密" Style="{StaticResource KvKey}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="AES-256" Style="{StaticResource KvVal}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="威胁" Style="{StaticResource KvKey}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="0 无异常" Style="{StaticResource KvVal}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="防火墙" Style="{StaticResource KvKey}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentDeepBrush}" Style="{StaticResource BlinkLed}"/>
                                            <TextBlock Text="运行中" Style="{StaticResource KvVal}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </local:NeuPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ CORE CONFIGURATION 底部紧凑模块 ============ -->
                <local:NeuPanel x:Name="CoreCfgPanel" Grid.Row="2" Padding="14,10" CornerRadius="5">
                    <WrapPanel ItemHeight="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                            <TextBlock Text="资源路径" Style="{StaticResource CfgLabel}" Margin="0,0,8,0"/>
                            <TextBox x:Name="GameDirBox" Width="120" Text="D:\Games" VerticalContentAlignment="Center"
                                     ToolTip="游戏安装根目录"/>
                            <Button x:Name="BrowseButton" Content="浏览" Margin="6,0,0,0"
                                    Padding="10,0" Click="OnBrowseClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                            <TextBlock Text="神经模型" Style="{StaticResource CfgLabel}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ModelNameText" Text="—" MinWidth="130"
                                       FontFamily="{StaticResource DataFont}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="智能体" Style="{StaticResource CfgLabel}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusLineText" Text="空闲" MinWidth="90"
                                       FontFamily="{StaticResource DataFont}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="运行模式" Style="{StaticResource CfgLabel}" Margin="0,0,8,0"/>
                            <RadioButton x:Name="EditModeRadio" Content="编辑" GroupName="RunMode"
                                         IsChecked="True" Checked="OnModeChanged"/>
                            <RadioButton x:Name="PlanModeRadio" Content="方案" GroupName="RunMode" Margin="12,0,0,0"
                                         Checked="OnModeChanged"/>
                            <RadioButton x:Name="CompanionModeRadio" Content="陪伴" GroupName="RunMode" Margin="12,0,0,0"
                                         ToolTip="只陪你聊天：不调用智能体、不操作文件，支持多轮对话"
                                         Checked="OnModeChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="安全访问" Style="{StaticResource CfgLabel}" Margin="0,0,8,0"/>
                            <RadioButton x:Name="SandboxAccessRadio" Content="沙箱"
                                         GroupName="AccessMode" IsChecked="True"
                                         ToolTip="改动任务先请求授权，沙箱副本执行，审核后才写入真实目录"
                                         Checked="OnAccessModeChanged"/>
                            <RadioButton x:Name="DirectAccessRadio" Content="直接" GroupName="AccessMode" Margin="12,0,0,0"
                                         ToolTip="智能体获任务后直接操作真实文件"
                                         Checked="OnAccessModeChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="启动协议" Style="{StaticResource CfgLabel}" Margin="0,0,8,0"/>
                            <RadioButton x:Name="StartupModeAlways" Content="每次" GroupName="StartupMode"
                                         Checked="OnStartupPrefsChanged"/>
                            <RadioButton x:Name="StartupModeFirst" Content="首次" GroupName="StartupMode" Margin="12,0,0,0"
                                         Checked="OnStartupPrefsChanged"/>
                            <RadioButton x:Name="StartupModeNever" Content="关闭" GroupName="StartupMode" Margin="12,0,0,0"
                                         Checked="OnStartupPrefsChanged"/>
                            <CheckBox x:Name="StartupSoundCheck" Content="音效" Margin="14,0,0,0"
                                      Checked="OnStartupPrefsChanged" Unchecked="OnStartupPrefsChanged"/>
                        </StackPanel>
                        <Button x:Name="SettingsButton" Content="完整配置" Margin="18,0,0,0"
                                Style="{StaticResource SideNavButtonStyle}"
                                Click="OnSettingsClick" ToolTip="打开 API 密钥与智能体完整配置"/>
                    </WrapPanel>
                </local:NeuPanel>

                <!-- 完整配置面板（覆盖层） -->
                <local:NeuPanel x:Name="SettingsPanel" Grid.RowSpan="3"
                                Visibility="Collapsed" CornerRadius="6"
                                Padding="18" Margin="26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：API 配置 -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="大模型 API 配置" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="服务商" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ProviderCombo" Margin="0,4,0,12"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnProviderChanged"/>
                            <TextBlock Text="模型" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ModelCombo" IsEditable="True" Margin="0,4,0,4"
                                      ToolTip="可下拉选择，也可直接输入自定义模型名，如 glm-4.5-air"/>
                            <TextBlock Text="可直接输入自定义模型名（如 glm-4.5-air）"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                       Opacity="0.75" Margin="0,0,0,12"/>
                            <TextBlock Text="API Base URL" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="ApiBaseBox" Margin="0,4,0,12"/>
                            <TextBlock Text="API Key（留空则不修改）"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Grid Margin="0,4,0,8">
                                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyBoxChanged"/>
                                <TextBox x:Name="ApiKeyText" Visibility="Collapsed"
                                         TextChanged="OnApiKeyTextChanged"/>
                            </Grid>
                            <CheckBox x:Name="ShowApiKeyCheck" Content="显示密钥"
                                      Margin="0,0,0,12"
                                      Checked="OnShowApiKeyToggle" Unchecked="OnShowApiKeyToggle"/>

                            <TextBlock Text="已保存的密钥" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="SavedKeysList" MaxHeight="120" Margin="0,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button Content="删除" DockPanel.Dock="Right"
                                                    Padding="10,4" Margin="8,0,0,0"
                                                    Click="OnDeleteApiKeyClick" Tag="{Binding Provider}"/>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Display}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 右：启用配置 + 偏好 -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="智能体启用配置" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ListBox x:Name="AgentSettingList" Height="140"
                                     Background="{StaticResource BgBrush}" Padding="6"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="角色人格" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <CheckBox x:Name="PersonaEnabledCheck"
                                      Content="爱弥斯人格（语气与说话习惯）"/>

                            <TextBlock Text="界面与动效" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <CheckBox x:Name="GridBgCheck" Content="科技网格背景"
                                      Checked="OnUiPrefsChanged" Unchecked="OnUiPrefsChanged"/>
                            <CheckBox x:Name="ReducedMotionCheck" Content="减少动画（停止装饰动画）"
                                      Margin="0,4,0,0"
                                      Checked="OnUiPrefsChanged" Unchecked="OnUiPrefsChanged"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button x:Name="SaveSettingsButton" Content="保存" MinWidth="76"
                                        Margin="0,0,8,0" Click="OnSaveSettingsClick"
                                        Style="{StaticResource NeuAccentButtonStyle}"/>
                                <Button x:Name="CloseSettingsButton" Content="关闭" MinWidth="76"
                                        Click="OnCloseSettingsClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </local:NeuPanel>
            </Grid>

            <!-- ============ 视图二：指令中枢 ============ -->
            <Grid x:Name="DirectiveView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题条 -->
                <DockPanel Grid.Row="0" Margin="2,0,2,10">
                    <Border Width="16" Height="2" Background="{StaticResource AccentDeepBrush}"
                            VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="指令中枢" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="DIRECTIVE TERMINAL" FontFamily="{StaticResource DataFont}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,2,0,0"/>
                </DockPanel>

                <!-- 聊天区 -->
                <local:NeuPanel Grid.Row="1" Padding="0" CornerRadius="5">
                    <Grid>
                        <!-- 思考扫描线 -->
                        <Border x:Name="ThinkScanLine" Height="1" Width="150"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" IsHitTestVisible="False"
                                Background="{StaticResource AccentDeepBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#45BFD2" BlurRadius="6"
                                                  ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThinkScanX"/>
                            </Border.RenderTransform>
                        </Border>

                        <DockPanel Margin="14">
                            <!-- 底部输入行 -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button x:Name="SendButton" Content="发送" DockPanel.Dock="Right"
                                        MinWidth="80" Margin="12,0,0,0"
                                        IsDefault="True" Click="OnSendClick"
                                        Style="{StaticResource NeuAccentButtonStyle}"/>
                                <ToggleButton x:Name="SearchToggle" Content="联网搜索"
                                              DockPanel.Dock="Left" Margin="0,0,8,0"
                                              ToolTip="开启后大模型可联网搜索或下载文件"
                                              Checked="OnSearchToggleChanged" Unchecked="OnSearchToggleChanged"/>
                                <ToggleButton x:Name="ThinkToggle" Content="思考强度 ▸"
                                              DockPanel.Dock="Left" Margin="0,0,8,0"
                                              Checked="OnThinkToggleChanged" Unchecked="OnThinkToggleChanged"/>
                                <TextBox x:Name="ChatInput"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="52" MaxHeight="150"
                                         PreviewKeyDown="OnChatInputKeyDown"
                                         ToolTip="按 Enter 直接发送；Shift+Enter 换行"/>
                            </DockPanel>

                            <!-- 思考强度面板 -->
                            <local:NeuPanel x:Name="ThinkPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                                            Inset="True" Padding="14,12" Margin="0,12,0,0" CornerRadius="5"
                                            PanelBackground="{StaticResource BluePanelBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock x:Name="ThinkLevelLabel" Text="思考强度：中度"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center"
                                                   Foreground="{StaticResource BlueAccentDeepBrush}"
                                                   FontWeight="SemiBold" Margin="0,0,16,0"/>
                                        <Slider x:Name="ThinkSlider" Minimum="0" Maximum="2"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="1" VerticalAlignment="Center"
                                                ValueChanged="OnThinkLevelChanged"/>
                                    </DockPanel>
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="轻度"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="中度"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="重度"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </local:NeuPanel>

                            <!-- 消息流 -->
                            <ListBox x:Name="ChatMessages"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}"
                                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><TranslateTransform/></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding RelativeSource="{RelativeSource Self}"
                                                             Path="(local:Fx.MotionEnabled)"/>
                                                </DataTrigger.Binding>
                                                <DataTrigger.Setters>
                                                    <Setter Property="Opacity" Value="0"/>
                                                </DataTrigger.Setters>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.35"/>
                                                            <DoubleAnimation
                                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                             From="12" To="0" Duration="0:0:0.35"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <local:NeuPanel x:Name="Bubble" Margin="0,6" Padding="14,10" CornerRadius="6"
                                                        Background="{StaticResource BubbleAssistantBrush}"
                                                        BorderBrush="{StaticResource BubbleAssistantLineBrush}"
                                                        HorizontalAlignment="Left">
                                            <Grid>
                                                <Ellipse x:Name="AssistantDot" Width="4" Height="4"
                                                         Fill="{StaticResource AccentDeepBrush}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                                         Margin="-3,-3,0,0" IsHitTestVisible="False"/>
                                                <StackPanel x:Name="TextPanel">
                                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold"
                                                               FontSize="12" Opacity="0.55"/>
                                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                                             Style="{StaticResource SelectableText}"
                                                             FontSize="13.5" Margin="0,4,0,0"/>
                                                    <Expander x:Name="ThinkingExpander"
                                                              Header="过程记录"
                                                              Margin="0,8,0,0"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              Visibility="Collapsed">
                                                        <Border Background="{StaticResource BgBrush}"
                                                                CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                                            <ItemsControl ItemsSource="{Binding Narration}"
                                                                          MaxHeight="260">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <ContentPresenter Margin="0,1"
                                                                            Content="{Binding ., Mode=OneWay,
                                                                                Converter={x:Static local:ThinkingLogConverter.Instance}}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </Expander>
                                                </StackPanel>

                                                <Border x:Name="DotsHost" Width="84" Height="20"
                                                        ClipToBounds="True" Visibility="Collapsed">
                                                    <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Opacity="0">
                                                        <StackPanel.RenderTransform>
                                                            <TranslateTransform x:Name="DotsTranslate"/>
                                                        </StackPanel.RenderTransform>
                                                        <Ellipse Width="8" Height="8"
                                                                 Fill="{StaticResource AccentDeepBrush}" Margin="3,0"/>
                                                        <Ellipse Width="8" Height="8"
                                                                 Fill="{StaticResource AccentDeepBrush}" Margin="3,0"/>
                                                        <Ellipse Width="8" Height="8"
                                                                 Fill="{StaticResource AccentDeepBrush}" Margin="3,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </local:NeuPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Bubble" Property="Background"
                                                        Value="{StaticResource BubbleUserBrush}"/>
                                                <Setter TargetName="Bubble" Property="BorderBrush"
                                                        Value="{StaticResource BubbleUserLineBrush}"/>
                                                <Setter TargetName="AssistantDot" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTyping}" Value="True">
                                                <Setter TargetName="TextPanel" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DotsHost" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasNarration}" Value="True">
                                                <Setter TargetName="ThinkingExpander" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding ElementName="DotsHost" Path="(local:Fx.MotionEnabled)"/>
                                                </DataTrigger.Binding>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="DotsLoopBegin">
                                                        <Storyboard Duration="0:0:2.4" RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DotsTranslate"
                                                                Storyboard.TargetProperty="X">
                                                                <LinearDoubleKeyFrame Value="-42" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="21" KeyTime="0:0:0.6"/>
                                                                <LinearDoubleKeyFrame Value="21" KeyTime="0:0:1.8"/>
                                                                <LinearDoubleKeyFrame Value="84" KeyTime="0:0:2.4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames
                                                                Storyboard.TargetName="DotsPanel"
                                                                Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.3"/>
                                                                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:2.1"/>
                                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="DotsLoopBegin"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </local:NeuPanel>

                <!-- 运行状态监控 -->
                <local:NeuPanel Grid.Row="2" Padding="12,8" Margin="0,10,0,0" CornerRadius="5">
                    <Expander Header="运行状态监控" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="当前智能体：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="CurrentAgentText" Text="—" FontWeight="SemiBold"
                                           Margin="0,0,24,0"/>
                                <TextBlock Text="访问路径：" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="CurrentPathText" Text="—"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ListBox x:Name="EventList" Height="84" Margin="0,8,0,0"
                                     Background="{StaticResource BgBrush}" Padding="8,6"
                                     FontFamily="Consolas" FontSize="11"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ., Mode=OneWay}"
                                                 Style="{StaticResource SelectableText}"
                                                 FontFamily="Consolas" FontSize="11"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>
                </local:NeuPanel>
            </Grid>
        </Grid>

        <!-- 二级页面容器（技能 / MCP 管理，覆盖主界面） -->
        <Frame x:Name="PageHost" Grid.ColumnSpan="2" Visibility="Collapsed"
               NavigationUIVisibility="Hidden" Background="{StaticResource BgBrush}"/>
    </Grid>
</Window>
