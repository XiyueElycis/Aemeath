<Page x:Class="AemeathAgent.Desktop.McpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MCP 管理"
      Background="{StaticResource BgBrush}"
      FontFamily="Microsoft YaHei UI" FontSize="13"
      TextElement.Foreground="{StaticResource TextPrimaryBrush}">

    <DockPanel Margin="20">

        <!-- 顶部工具条 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button Content="返回" DockPanel.Dock="Left" MinWidth="76"
                    Click="OnBackClick"/>
            <Button Content="保存" DockPanel.Dock="Right" MinWidth="76"
                    Click="OnSaveClick" Style="{StaticResource NeuAccentButtonStyle}"/>
            <TextBlock Text="MCP 管理（Model Context Protocol）" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </DockPanel>

        <!-- 状态提示 -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,12,0,0" Text="正在加载..."/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 内置清单 -->
            <TextBlock Grid.Row="0" Text="内置能力" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <ListBox Grid.Row="1" x:Name="McpList"
                     Background="{StaticResource WellBrush}" Padding="10,8"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,12,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Transport}"
                                               Foreground="{StaticResource AccentDeepBrush}"
                                               Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 外部服务器注册 -->
            <TextBlock Grid.Row="2" Margin="0,16,0,8" FontWeight="SemiBold"
                       Text="外部 MCP 服务器（stdio，编程智能体可直接调用）"/>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 新增表单 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="ServerNameBox" DockPanel.Dock="Left" Width="140"
                             Padding="8,6" VerticalContentAlignment="Center"
                             Text=""/>
                    <Button Content="添加" DockPanel.Dock="Right" MinWidth="68"
                            Margin="8,0,0,0" Click="OnAddServerClick"
                            Style="{StaticResource NeuAccentButtonStyle}"/>
                    <TextBox x:Name="ServerCommandBox" Padding="8,6" Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             Text=""/>
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="ServerList"
                         Background="{StaticResource WellBrush}" Padding="10,8"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button Content="删除" DockPanel.Dock="Right" MinWidth="56"
                                        Margin="8,0,0,0" Tag="{Binding Name}"
                                        Click="OnDeleteServerClick"/>
                                <Button Content="测试" DockPanel.Dock="Right" MinWidth="56"
                                        Margin="8,0,0,0" Tag="{Binding Name}"
                                        Click="OnProbeServerClick"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="（已停用）" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CommandText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

    </DockPanel>
</Page>
